# EasyInvio external-sharing environment template
# Includes every valid assignment in the local .env plus documented optional settings.
# Credentials, account/workspace IDs, contacts and personal paths are placeholders only.
# This is an illustrative template, not a copy of deployed configuration.
# Optional integrations stay disabled until privately configured and verified.
# JSON settings use empty objects/arrays; fill them only in your private .env.
# Never share your real .env or replace placeholders in a copy intended for sharing.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://EXAMPLE_USER:REPLACE_WITH_DATABASE_PASSWORD@db.example.com:5432/EXAMPLE_DATABASE
# JSON object of key IDs to privately generated Fernet keys. Never share actual values.
CREDENTIAL_KEYS={}
REGIONAL_ALLOWED_ORIGINS=[]
PARTNER_DOCUMENT_ALLOWED_HOSTS=[]
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
CHECKOUT_SUCCESS_URL=https://app.example.com/?checkout=success
CHECKOUT_CANCEL_URL=https://app.example.com/?checkout=cancel
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
# Replace with the sender approved for your Twilio account; not a customer number.
TWILIO_WHATSAPP_NUMBER=REPLACE_WITH_TWILIO_WHATSAPP_NUMBER
TWILIO_WEBHOOK_URL=https://app.example.com/api/v1/integrations/whatsapp/webhook
WHATSAPP_QUEUE_WORKERS=2
IDEAL_POSTCODES_API_KEY=REPLACE_WITH_IDEAL_POSTCODES_API_KEY
LOGISTICS_MEDIA_BUCKET=example-logistics-media
BOOKING_PAGE_URL=https://app.example.com/
QUOTE_LINK_SECRET=REPLACE_WITH_QUOTE_LINK_SECRET
JWT_ALGORITHM=ES256
JWT_AUDIENCE=authenticated
STRIPE_LIVEMODE=false
PROVIDER_ENVIRONMENT=TEST
INTEGRATION_EASYPOST_ENABLED=false
INTEGRATION_SENDCLOUD_ENABLED=false
INTEGRATION_SHIPPO_ENABLED=false
INTEGRATION_REGIONAL_ENABLED=false
INTEGRATION_ROYAL_MAIL_ENABLED=false
INTEGRATION_EVRI_ENABLED=false
TRACKING_POLLING_ENABLED=false
QUOTE_TTL_SECONDS=300
DATABASE_ENVIRONMENT=SANDBOX
SANDBOX_HOOKS_ENABLED=false
TWILIO_WHATSAPP_SANDBOX_ENABLED=false
PORT=8000
FRONTEND_ALLOWED_ORIGINS=["https://app.example.com"]
# JSON array of authorised auth user UUIDs; no actual user IDs included.
PLATFORM_ADMIN_USER_IDS=[]
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=REPLACE_WITH_HUBSPOT_ACCESS_TOKEN
# Replace with your own HubSpot portal/account identifier.
HUBSPOT_EXPECTED_PORTAL_ID=REPLACE_WITH_HUBSPOT_EXPECTED_PORTAL_ID
HUBSPOT_ENVIRONMENT=PRODUCTION
HUBSPOT_UPSELL_ENABLED=false
HUBSPOT_UPSELL_PIPELINE_ID=REPLACE_WITH_HUBSPOT_UPSELL_PIPELINE_ID
HUBSPOT_UPSELL_STAGE_ID=REPLACE_WITH_HUBSPOT_UPSELL_STAGE_ID
STRIPE_ENABLED=false
TWILIO_ENABLED=false
DATABASE_TLS_STRICT=true
RUNTIME_ROLE=AUTO
DB_POOL_MAX_SIZE=10
WORKER_DB_POOL_MAX_SIZE=8
# JSON object of source bindings. Replace tenant/account IDs and signing secrets privately.
TRACKING_WEBHOOK_KEYS={}
AUTOMATION_PURCHASE_ENABLED=false
FREIGHT_KG_PER_M3=333
FREIGHT_KG_PER_LOADING_METRE=1750
FREIGHT_DECK_WIDTH_M=2.4
# JSON connector objects; supply credentials and private workspace IDs only in your own .env.
ECOMMERCE_CONNECTORS={}
SENDCLOUD_METHODS={}
CARRIER_PDF_HOSTS=[]
SUPPORT_WHATSAPP_ENABLED=false
SUPPORT_WHATSAPP_CONTENT_SID=REPLACE_WITH_SUPPORT_WHATSAPP_CONTENT_SID
SUPPORT_WHATSAPP_STATUS_URL=https://app.example.com/api/v1/support/whatsapp/status
HUBSPOT_PROVISIONING_ENABLED=false
HUBSPOT_WEBHOOK_CLIENT_SECRET=REPLACE_WITH_HUBSPOT_WEBHOOK_CLIENT_SECRET
HUBSPOT_WEBHOOK_APP_ID=REPLACE_WITH_HUBSPOT_WEBHOOK_APP_ID
HUBSPOT_WEBHOOK_URL=https://app.example.com/api/v1/integrations/hubspot-webhook
HUBSPOT_CLOSED_WON_STAGE_IDS=[]
NGROK_AUTHTOKEN=REPLACE_WITH_NGROK_AUTHTOKEN
WHATSAPP_BRAND_NAME=EasyInvio.com
AUTH_JWT_SECRET=REPLACE_WITH_AUTH_JWT_SECRET
AUTH_RECOVERY_REDIRECT_URL=https://app.example.com/
XCOVER_ENABLED=false
XCOVER_ENVIRONMENT=TEST
XCOVER_PARTNER_ID=REPLACE_WITH_XCOVER_PARTNER_ID
XCOVER_API_KEY=REPLACE_WITH_XCOVER_API_KEY
XCOVER_SIGNING_SECRET=REPLACE_WITH_XCOVER_SIGNING_SECRET
XCOVER_PARCEL_CONTRACT_VERIFIED=false
XCOVER_RETAIL_PRICING_VERIFIED=false
XCOVER_CLAIMS_ENABLED=false
XCOVER_CLAIMS_PARTNER_CODE=REPLACE_WITH_XCOVER_CLAIMS_PARTNER_CODE
XCOVER_CLAIMS_API_KEY=REPLACE_WITH_XCOVER_CLAIMS_API_KEY
XCOVER_CLAIMS_API_PASSWORD=REPLACE_WITH_XCOVER_CLAIMS_API_PASSWORD
XCOVER_CLAIMS_WEBHOOK_SECRET=REPLACE_WITH_XCOVER_CLAIMS_WEBHOOK_SECRET
XCOVER_CLAIMS_WEBHOOK_URL=https://app.example.com/api/v1/shipping/insurance-updates
# Use the issued insurer API origin; do not assume an example hostname is operational.
XCOVER_CLAIMS_LIVE_API_ORIGIN=REPLACE_WITH_XCOVER_CLAIMS_LIVE_API_ORIGIN
XCOVER_CLAIMS_FNOL_BINDINGS={}
XCOVER_CLAIMS_SETTLEMENT_MAPPING={}
XCOVER_CLAIMS_MASTER_PAYEE_ID=REPLACE_WITH_XCOVER_CLAIMS_MASTER_PAYEE_ID
LOGISTICS_AGENTS_ENABLED=false
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
LOGISTICS_AGENT_MODEL=gpt-4o-mini
LOGISTICS_EMBEDDING_MODEL=text-embedding-3-small
LOGISTICS_AGENT_TIMEOUT_SECONDS=6
LOGISTICS_AGENT_CONCURRENCY=4
LOGISTICS_AGENT_OUTPUT_TOKENS=600
LOGISTICS_HELP_TIMEOUT_SECONDS=15
LOGISTICS_HELP_OUTPUT_TOKENS=1600
LOGISTICS_HELP_WEB_SEARCH_ENABLED=false
LOGISTICS_WEB_SEARCH_MODEL=gpt-4.1-mini
LOGISTICS_AGENT_TOKENS_PER_MINUTE=100000
LOGISTICS_AGENT_REQUESTS_PER_MINUTE=20
LOGISTICS_AGENT_CACHE_ENTRIES=256
WHATSAPP_ONBOARDING_ENABLED=false
WHATSAPP_ONBOARDING_DAILY_LIMIT=100
COMPANIES_HOUSE_API_KEY=REPLACE_WITH_COMPANIES_HOUSE_API_KEY
EMAIL_DELIVERY_PROVIDER=HOSTINGER_SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_TIMEOUT_SECONDS=10
RETURN_EMAIL_ENABLED=false
RETURN_SENDGRID_API_KEY=REPLACE_WITH_RETURN_SENDGRID_API_KEY
RETURN_EMAIL_FROM=sender@example.com
RETURN_WHATSAPP_ENABLED=false
RETURN_WHATSAPP_CONTENT_SID=REPLACE_WITH_RETURN_WHATSAPP_CONTENT_SID
RETURN_WHATSAPP_MESSAGING_SERVICE_SID=REPLACE_WITH_RETURN_WHATSAPP_MESSAGING_SERVICE_SID
SHIPMENT_EMAIL_NOTIFICATIONS_ENABLED=false
SHIPMENT_SENDGRID_API_KEY=REPLACE_WITH_SHIPMENT_SENDGRID_API_KEY
SHIPMENT_EMAIL_FROM=sender@example.com
SHIPMENT_WHATSAPP_NOTIFICATIONS_ENABLED=false
SHIPMENT_WHATSAPP_CONTENT_SID=REPLACE_WITH_SHIPMENT_WHATSAPP_CONTENT_SID
# JSON array, e.g. ["tester@example.com", "REPLACE_WITH_TEST_PHONE_E164"].
SHIPMENT_NOTIFICATION_TEST_RECIPIENTS=[]
# JSON array of selected UAT tenant UUIDs; no actual tenant IDs included.
HUBSPOT_UAT_TENANT_IDS=[]
# Private test recipient in E.164 format; keep it out of externally shared files.
TWILIO_SANDBOX_TEST_PHONE=REPLACE_WITH_TWILIO_SANDBOX_TEST_PHONE
# Replace with your own CA certificate path; no personal filesystem path included.
DATABASE_CA_FILE=C:/path/to/database-ca.pem
