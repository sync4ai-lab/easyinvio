# Copy to .env and replace placeholders for configured mode.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Backend-only: legacy service_role JWT or modern sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Generate: .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEYS={"v1":"REPLACE_WITH_FERNET_KEY"}
REGIONAL_ALLOWED_ORIGINS=["https://YOUR_REGIONAL_PROVIDER"]
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
CHECKOUT_SUCCESS_URL=https://YOUR_APP/payment/success
CHECKOUT_CANCEL_URL=https://YOUR_APP/payment/cancel
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_32_HEX_CHARACTERS
TWILIO_AUTH_TOKEN=replace-me
TWILIO_WHATSAPP_NUMBER=+REPLACE_WITH_E164_NUMBER
TWILIO_WEBHOOK_URL=https://YOUR_API/webhooks/twilio/whatsapp
BOOKING_PAGE_URL=https://YOUR_APP/book
QUOTE_LINK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=ES256
JWT_AUDIENCE=authenticated
STRIPE_LIVEMODE=false
PROVIDER_ENVIRONMENT=TEST
DATABASE_ENVIRONMENT=LIVE
# Enable only with a dedicated sandbox database, sk_test_ Stripe key and marked test tenants.
SANDBOX_HOOKS_ENABLED=false
TWILIO_WHATSAPP_SANDBOX_ENABLED=false
# When using the Twilio Sandbox, set TWILIO_WHATSAPP_NUMBER=+14155238886.
# DATABASE_CA_FILE=C:/path/to/database-ca.pem
PORT=8000
FRONTEND_ALLOWED_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
# Supabase Auth user UUIDs allowed to administer all tenants (not customer OWNER roles).
# Set to ["your-real-auth-user-uuid"] to enable platform administration.
PLATFORM_ADMIN_USER_IDS=[]
# Optional HubSpot CRM. pat-* tokens are account credentials, not test-mode keys.
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_EXPECTED_PORTAL_ID=
HUBSPOT_ENVIRONMENT=SANDBOX
HUBSPOT_UPSELL_ENABLED=false
HUBSPOT_UPSELL_PIPELINE_ID=
HUBSPOT_UPSELL_STAGE_ID=

# Leave payment/messaging integrations disabled until their credentials exist.
STRIPE_ENABLED=false
TWILIO_ENABLED=false

# Default strict TLS. Supabase's legacy 2021 intermediate may need false on Python 3.13+.
# CA signature, validity and hostname verification remain enabled in either mode.
DATABASE_TLS_STRICT=true

# Tracking adapter HMAC keys: key_id -> tenant/account UUID, secret (32+ bytes), approved POD hosts.
# Configure actual account-specific keys before enabling aggregator callbacks.
TRACKING_WEBHOOK_KEYS={}

# Real bulk label purchases require this flag, LIVE provider accounts and non-sandbox tenants.
AUTOMATION_PURCHASE_ENABLED=false
# Contract-specific road freight factors. These are configurable, not universal NMFC classes.
FREIGHT_KG_PER_M3=333
FREIGHT_KG_PER_LOADING_METRE=1750
FREIGHT_DECK_WIDTH_M=2.4

# Server-only store UUID -> connector configuration; empty disables public store intake.
# See docs/core_pillars/REPORT.md for signing, SKU weights and opt-in fulfillment.
ECOMMERCE_CONNECTORS={}
# Account UUID -> verified Sendcloud v2 method limits. No invented default tariff.
SENDCLOUD_METHODS={}

# Exact trusted public carrier PDF hosts (JSON array). Empty disables remote downloads.
CARRIER_PDF_HOSTS=[]
# Optional proactive support delivery: requires TWILIO_ENABLED and an approved
# WhatsApp template with one variable containing the stored remedy text.
# Without Content SID, alerts wait for a verified recent inbound service window.
SUPPORT_WHATSAPP_ENABLED=false
SUPPORT_WHATSAPP_CONTENT_SID=
SUPPORT_WHATSAPP_STATUS_URL=
