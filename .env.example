# Copy to .env and replace placeholders for configured mode.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Backend-only: legacy service_role JWT or modern sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Generate: .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEYS={"v1":"REPLACE_WITH_FERNET_KEY"}
REGIONAL_ALLOWED_ORIGINS='["https://YOUR_REGIONAL_PROVIDER", "https://panel.sendcloud.sc", "https://api.goshippo.com"]'
# Exact HTTPS document hosts approved for authenticated EasyInvio PDF downloads.
PARTNER_DOCUMENT_ALLOWED_HOSTS='["easypost-files.s3.amazonaws.com", "easypost-files.s3.us-west-2.amazonaws.com", "deliver.goshippo.com", "shippo-delivery.s3.amazonaws.com", "panel.sendcloud.sc"]'
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
CHECKOUT_SUCCESS_URL=http://127.0.0.1:8000/?payment=success
CHECKOUT_CANCEL_URL=http://127.0.0.1:8000/?payment=cancel
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_32_HEX_CHARACTERS
TWILIO_AUTH_TOKEN=replace-me
TWILIO_WHATSAPP_NUMBER=+REPLACE_WITH_E164_NUMBER
TWILIO_WEBHOOK_URL=https://YOUR_API/api/v1/integrations/whatsapp/webhook
# Apply migration 043 before enabling Twilio. Replies use the encrypted PostgreSQL queue.
WHATSAPP_QUEUE_WORKERS=2
# Licensed Royal Mail PAF lookup for web pickup/delivery, WhatsApp and live UK booking checks.
# LIVE UK quotes/purchases require a matching PAF delivery point; TEST without a key permits unverified fixtures.
# No guessed/manual UK street fallback in conversational quotes when lookup is unavailable.
IDEAL_POSTCODES_API_KEY=
# Migration 044 creates this private bucket on Supabase; never make it public.
LOGISTICS_MEDIA_BUCKET=easyinvio-logistics
# HTTPS dashboard root for WhatsApp checkout links; omit the webhook endpoint.
# Required for Book option N to hand off to web checkout.
BOOKING_PAGE_URL=
QUOTE_LINK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=ES256
JWT_AUDIENCE=authenticated
STRIPE_LIVEMODE=false
PROVIDER_ENVIRONMENT=TEST
# Restart the application after changing integration switches. Existing credentials,
# tenant account activation and TEST/LIVE purchase controls still apply.
INTEGRATION_EASYPOST_ENABLED=true
INTEGRATION_SENDCLOUD_ENABLED=true
INTEGRATION_SHIPPO_ENABLED=true
INTEGRATION_REGIONAL_ENABLED=true
# Provisioned extension points only: issued API contracts and certification required.
# Setting true alone cannot activate an unregistered direct transport.
INTEGRATION_ROYAL_MAIL_ENABLED=false
INTEGRATION_EVRI_ENABLED=false
# Migration 045 adds free shared tracking and secure customer links.
# Existing signed webhooks do not require polling. Enable GET-only EasyPost
# reconciliation only after reviewing the account's quotas/contract costs.
TRACKING_POLLING_ENABLED=false
# Customer quotes expire server-side after this many seconds (30..900).
# This is EasyInvio's validity window, not a universal carrier price guarantee.
QUOTE_TTL_SECONDS=300
DATABASE_ENVIRONMENT=LIVE
# Enable only with a dedicated sandbox database, sk_test_ Stripe key and marked test tenants.
SANDBOX_HOOKS_ENABLED=false
TWILIO_WHATSAPP_SANDBOX_ENABLED=false
# When using the Twilio Sandbox, set TWILIO_WHATSAPP_NUMBER=+14155238886.
# DATABASE_CA_FILE=C:/path/to/database-ca.pem
PORT=8000
FRONTEND_ALLOWED_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
# Supabase Auth user UUIDs allowed to administer all tenants (not customer OWNER roles).
# Set to ["your-real-auth-user-uuid"] to enable platform administration.
PLATFORM_ADMIN_USER_IDS=[]
# Optional HubSpot CRM. pat-* tokens are account credentials, not test-mode keys.
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_EXPECTED_PORTAL_ID=
HUBSPOT_ENVIRONMENT=SANDBOX
HUBSPOT_UPSELL_ENABLED=false
HUBSPOT_UPSELL_PIPELINE_ID=
HUBSPOT_UPSELL_STAGE_ID=

# Leave payment/messaging integrations disabled until their credentials exist.
STRIPE_ENABLED=false
TWILIO_ENABLED=false

# Default strict TLS. Supabase's legacy 2021 intermediate may need false on Python 3.13+.
# CA signature, validity and hostname verification remain enabled in either mode.
DATABASE_TLS_STRICT=true

# AUTO keeps local web + jobs together; Vercel sets WEB in vercel.json.
# The dedicated daemon always overrides its own role to WORKER.
RUNTIME_ROLE=AUTO
# Local combined mode retains its pool budget; hosted WEB is capped at two.
DB_POOL_MAX_SIZE=10
WORKER_DB_POOL_MAX_SIZE=8

# Tracking adapter HMAC keys: key_id -> tenant/account UUID, secret (32+ bytes), approved POD hosts.
# Configure actual account-specific keys before enabling aggregator callbacks.
TRACKING_WEBHOOK_KEYS={}

# Real bulk label purchases require this flag, LIVE provider accounts and non-sandbox tenants.
AUTOMATION_PURCHASE_ENABLED=false
# Contract-specific road freight factors. These are configurable, not universal NMFC classes.
FREIGHT_KG_PER_M3=333
FREIGHT_KG_PER_LOADING_METRE=1750
FREIGHT_DECK_WIDTH_M=2.4

# Server-only store UUID -> connector configuration; empty disables public store intake.
# See docs/core_pillars/REPORT.md for signing, SKU weights and opt-in fulfillment.
ECOMMERCE_CONNECTORS={}
# Account UUID -> verified Sendcloud v2 method limits. No invented default tariff.
SENDCLOUD_METHODS={}

# Exact trusted public carrier PDF hosts (JSON array). Empty disables remote downloads.
CARRIER_PDF_HOSTS=[]
# Optional proactive support delivery: requires TWILIO_ENABLED and an approved
# WhatsApp template with one variable containing the stored remedy text.
# Without Content SID, alerts wait for a verified recent inbound service window.
SUPPORT_WHATSAPP_ENABLED=false
SUPPORT_WHATSAPP_CONTENT_SID=
SUPPORT_WHATSAPP_STATUS_URL=

# Inbound HubSpot deal provisioning requires an app subscription (service keys alone do not deliver webhooks).
HUBSPOT_PROVISIONING_ENABLED=false
HUBSPOT_WEBHOOK_CLIENT_SECRET=
HUBSPOT_WEBHOOK_APP_ID=
HUBSPOT_WEBHOOK_URL=
HUBSPOT_CLOSED_WON_STAGE_IDS=["closedwon"]

# Local WhatsApp tunnel; private token from your ngrok dashboard. Never commit it.
NGROK_AUTHTOKEN=
WHATSAPP_BRAND_NAME=EasyInvio.com

# Backend-only random secret (at least 32 bytes) for the identity gateway.
AUTH_JWT_SECRET=

# Must be allowed in Supabase Auth URL Configuration. See docs/identity/password_recovery.md.
# Production: https://easyinvio.com/set-password only when that host serves this app.
# Auth SMTP credentials and sender are configured separately in Supabase Auth, not here.
AUTH_RECOVERY_REDIRECT_URL=http://127.0.0.1:8000/

# XCover: credential fields deliberately empty; no fake partner IDs or keys.
# Obtain the parcel product, retail tariff and master-account payout contract first.
XCOVER_ENABLED=false
XCOVER_ENVIRONMENT=TEST
XCOVER_PARTNER_ID=
XCOVER_API_KEY=
XCOVER_SIGNING_SECRET=
XCOVER_PARCEL_CONTRACT_VERIFIED=false
XCOVER_RETAIL_PRICING_VERIFIED=false

# Separate native XClaim programmatic JWT credentials and body-signature key.
XCOVER_CLAIMS_ENABLED=false
XCOVER_CLAIMS_PARTNER_CODE=
XCOVER_CLAIMS_API_KEY=
XCOVER_CLAIMS_API_PASSWORD=
XCOVER_CLAIMS_WEBHOOK_SECRET=
# Optional public HTTPS URL ending /api/v1/shipping/insurance-updates; polling also works.
XCOVER_CLAIMS_WEBHOOK_URL=
# Obtain the production origin from your integration manager; TEST uses documented staging.
XCOVER_CLAIMS_LIVE_API_ORIGIN=
# Partner-specific FNOL field -> saved source bindings. No invented field names.
XCOVER_CLAIMS_FNOL_BINDINGS={}
# Approved amount/currency/payment reference/payee/receipt flag/time JSON pointers,
# confirmed against the partner's authoritative GET-claim response.
XCOVER_CLAIMS_SETTLEMENT_MAPPING={}
XCOVER_CLAIMS_MASTER_PAYEE_ID=

# Optional bounded OpenAI assistance. Standard booking and finance work without it.
LOGISTICS_AGENTS_ENABLED=false
OPENAI_API_KEY=
LOGISTICS_AGENT_MODEL=gpt-4o-mini
LOGISTICS_EMBEDDING_MODEL=text-embedding-3-small
LOGISTICS_AGENT_TIMEOUT_SECONDS=6
LOGISTICS_AGENT_CONCURRENCY=4
LOGISTICS_AGENT_OUTPUT_TOKENS=600
# Documentation answers have a separate budget; action workers retain their limits.
LOGISTICS_HELP_TIMEOUT_SECONDS=15
LOGISTICS_HELP_OUTPUT_TOKENS=1600
# Read-only web fallback only when local product documentation has no relevant answer.
LOGISTICS_HELP_WEB_SEARCH_ENABLED=true
LOGISTICS_WEB_SEARCH_MODEL=gpt-4.1-mini
LOGISTICS_AGENT_TOKENS_PER_MINUTE=100000
LOGISTICS_AGENT_REQUESTS_PER_MINUTE=20
LOGISTICS_AGENT_CACHE_ENTRIES=256

# Optional signed WhatsApp signup. Apply migration 039 and configure Supabase email OTP first.
WHATSAPP_ONBOARDING_ENABLED=false
WHATSAPP_ONBOARDING_DAILY_LIMIT=100

# Optional, manually invoked Companies House company-level prospect research.
COMPANIES_HOUSE_API_KEY=

# Shared shipment/return email transport. Hostinger is the default; no SendGrid usage/failover.
EMAIL_DELIVERY_PROVIDER=HOSTINGER_SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@easyinvio.com
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
# Port 465 uses verified SSL; port 587 requires STARTTLS. Plaintext SMTP is not supported.
# Use the Hostinger mailbox password, not an API key. Never commit the real password.
# Customer return instructions (migration 046). Independent of Supabase Auth SMTP.
# Configure HTTPS BOOKING_PAGE_URL and QUOTE_LINK_SECRET (32+ characters) first.
RETURN_EMAIL_ENABLED=false
# Optional legacy key; used only with EMAIL_DELIVERY_PROVIDER=SENDGRID.
RETURN_SENDGRID_API_KEY=
RETURN_EMAIL_FROM=support@easyinvio.com
RETURN_WHATSAPP_ENABLED=false
# Approved utility template variables: {{1}} heading, {{2}} instructions, {{3}} full secure link.
RETURN_WHATSAPP_CONTENT_SID=
RETURN_WHATSAPP_MESSAGING_SERVICE_SID=

# Migration 047: transactional SENDER booking/journey updates (separate from return-customer notices).
SHIPMENT_EMAIL_NOTIFICATIONS_ENABLED=false
# Optional legacy key; used only with EMAIL_DELIVERY_PROVIDER=SENDGRID.
SHIPMENT_SENDGRID_API_KEY=
SHIPMENT_EMAIL_FROM=support@easyinvio.com
SHIPMENT_WHATSAPP_NOTIFICATIONS_ENABLED=false
# Approved utility template variables: 1=booking reference, 2=milestone message, 3=tracking reference.
SHIPMENT_WHATSAPP_CONTENT_SID=
# TEST sends require an explicit list of your test email addresses and/or E.164 phones.
SHIPMENT_NOTIFICATION_TEST_RECIPIENTS=[]

# Explicit sandbox-workspace exports to a STANDARD HubSpot account; companies are labelled [UAT].
# Keep HUBSPOT_ENVIRONMENT=PRODUCTION. Empty excludes sandbox clients. Never change shipping flags for CRM.
HUBSPOT_UAT_TENANT_IDS=[]
