# Normalize source across Windows and Linux checkouts.
* text=auto
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
docs/platform_overview/*.mmd text eol=lf
docs/platform_overview/*.svg text eol=lf
output/EasyInvio-Architecture/*.mmd text eol=lf
output/EasyInvio-Architecture/*.svg text eol=lf
